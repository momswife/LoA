{
  "name": "lore-vault",
  "description": "The Lore Vault of Aerathon, an Obsidian-authored D&D wiki published with a vendored Quartz engine.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "momswife",
  "license": "MIT",
  "homepage": "https://momswife.github.io/LoA/",
  "repository": {
    "type": "git",
    "url": "https://github.com/momswife/LoA.git"
  },
  "scripts": {
    "quartz": "node ./quartz/bootstrap-cli.mjs",
    "build": "node ./quartz/bootstrap-cli.mjs build",
    "build:ci": "node ./quartz/bootstrap-cli.mjs build --bundleInfo",
    "serve": "node ./quartz/bootstrap-cli.mjs build --serve",
    "docs:serve": "node ./quartz/bootstrap-cli.mjs build --serve -d docs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check package.json package-lock.json README.md AGENTS.md CONTENT_GUIDE.md WIKI_STYLE_GUIDE.md WIKI_REVIEW.md quartz.ts quartz.config.yaml quartz.layout.ts quartz/cli/constants.js quartz/cli/handlers.js quartz/components/Footer.tsx quartz/styles/custom.scss \".github/**/*.{yml,yaml,md}\" \"content/templates/**/*.md\"",
    "check": "npm run typecheck && npm run format:check",
    "format": "prettier --write package.json package-lock.json README.md AGENTS.md CONTENT_GUIDE.md WIKI_STYLE_GUIDE.md WIKI_REVIEW.md quartz.ts quartz.config.yaml quartz.layout.ts quartz/cli/constants.js quartz/cli/handlers.js quartz/components/Footer.tsx quartz/styles/custom.scss \".github/**/*.{yml,yaml,md}\" \"content/templates/**/*.md\"",
    "content:check": "node ./quartz/bootstrap-cli.mjs build --bundleInfo",
    "wiki:check": "node ./scripts/wiki-check.mjs",
    "wiki:format": "node ./scripts/wiki-format.mjs",
    "wiki:format:check": "node ./scripts/wiki-format.mjs --check",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "aerathon",
    "dnd",
    "wiki",
    "obsidian",
    "site generator",
    "ssg",
    "digital-garden",
    "markdown"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@floating-ui/dom": "^1.8.0",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "1.1.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.4",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isomorphic-git": "^1.41.9",
    "lightningcss": "^1.33.0",
    "micromorph": "^0.4.5",
    "minimatch": "^10.2.6",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "pretty-bytes": "^7.1.2",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.4",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.0",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
